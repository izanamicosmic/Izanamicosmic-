[
  {
    "name": "User",
    "system": true,
    "type": "object",
    "properties": {
      "vipUntil": {
        "type": "date",
        "description": "Date until which the user's VIP membership is active",
        "default": null
      }
    },
    "required": []
  },
  {
    "name": "Movie",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 100,
        "description": "Movie or series title"
      },
      "synopsis": {
        "type": "text",
        "description": "Short synopsis of the story"
      },
      "thumbnailUrl": {
        "type": "string",
        "maxLength": 500,
        "description": "Poster thumbnail image URL"
      },
      "backdropUrl": {
        "type": "string",
        "maxLength": 500,
        "description": "Wide backdrop image for the hero"
      },
      "contentType": {
        "type": "enum",
        "values": [
          "movie",
          "series"
        ],
        "labels": {
          "movie": "Film",
          "series": "Series"
        },
        "description": "Whether this is a single film or a series with episodes",
        "default": "movie"
      },
      "genre": {
        "type": "enum",
        "values": [
          "action",
          "drama",
          "horror",
          "comedy",
          "romance",
          "anime",
          "thriller",
          "scifi"
        ],
        "labels": {
          "action": "Aksi",
          "drama": "Drama",
          "horror": "Horor",
          "comedy": "Komedi",
          "romance": "Romantis",
          "anime": "Anime",
          "thriller": "Thriller",
          "scifi": "Sci-Fi"
        },
        "description": "Main genre"
      },
      "releaseYear": {
        "type": "number",
        "description": "Year of release"
      },
      "rating": {
        "type": "number",
        "description": "Star rating from 0 to 10",
        "default": 0
      },
      "views": {
        "type": "number",
        "description": "Total view count",
        "default": 0
      },
      "videoUrl": {
        "type": "string",
        "maxLength": 500,
        "description": "Streaming URL for a film (series use episodes)"
      },
      "downloadUrl360": {
        "type": "string",
        "maxLength": 500,
        "description": "Download link 360p"
      },
      "downloadUrl720": {
        "type": "string",
        "maxLength": 500,
        "description": "Download link 720p"
      },
      "downloadUrl1080": {
        "type": "string",
        "maxLength": 500,
        "description": "Download link 1080p"
      },
      "isVipOnly": {
        "type": "boolean",
        "description": "Locked post that only VIP members can open",
        "default": false
      },
      "isFeatured": {
        "type": "boolean",
        "description": "Shown in the home hero slider",
        "default": false
      },
      "publishedAt": {
        "type": "datetime",
        "description": "When the post was published"
      }
    },
    "required": [
      "title",
      "thumbnailUrl",
      "contentType",
      "publishedAt"
    ],
    "publicRead": true,
    "publicCreate": false
  },
  {
    "name": "Episode",
    "type": "object",
    "properties": {
      "movieId": {
        "type": "relation",
        "ref": "Movie",
        "parent": true,
        "description": "The series this episode belongs to"
      },
      "episodeNumber": {
        "type": "number",
        "description": "Episode order number"
      },
      "title": {
        "type": "string",
        "maxLength": 100,
        "description": "Episode title"
      },
      "videoUrl": {
        "type": "string",
        "maxLength": 500,
        "description": "Streaming URL of the episode"
      },
      "downloadUrl": {
        "type": "string",
        "maxLength": 500,
        "description": "Download link of the episode"
      },
      "isVipOnly": {
        "type": "boolean",
        "description": "Episode locked to VIP members",
        "default": false
      }
    },
    "required": [
      "movieId",
      "episodeNumber",
      "videoUrl"
    ],
    "publicRead": true,
    "publicCreate": false
  },
  {
    "name": "Bookmark",
    "type": "object",
    "properties": {
      "movieId": {
        "type": "relation",
        "ref": "Movie",
        "description": "The bookmarked movie or series"
      },
      "savedAt": {
        "type": "datetime",
        "description": "When the bookmark was added"
      }
    },
    "required": [
      "movieId"
    ],
    "publicRead": false,
    "publicCreate": false
  },
  {
    "name": "WatchHistory",
    "type": "object",
    "properties": {
      "movieId": {
        "type": "relation",
        "ref": "Movie",
        "description": "The movie or series that was watched"
      },
      "episodeId": {
        "type": "relation",
        "ref": "Episode",
        "description": "The episode watched, for series"
      },
      "progressPercent": {
        "type": "number",
        "description": "How far the user watched, 0-100",
        "default": 0
      },
      "watchedAt": {
        "type": "datetime",
        "description": "When it was last watched"
      }
    },
    "required": [
      "movieId",
      "watchedAt"
    ],
    "publicRead": false,
    "publicCreate": false
  },
  {
    "name": "Comment",
    "type": "object",
    "properties": {
      "movieId": {
        "type": "relation",
        "ref": "Movie",
        "parent": true,
        "description": "The movie this comment is on"
      },
      "authorName": {
        "type": "string",
        "maxLength": 100,
        "description": "Display name of the commenter"
      },
      "authorAvatar": {
        "type": "string",
        "maxLength": 500,
        "description": "Avatar URL of the commenter"
      },
      "body": {
        "type": "text",
        "description": "Comment text"
      },
      "postedAt": {
        "type": "datetime",
        "description": "When the comment was posted"
      }
    },
    "required": [
      "movieId",
      "body"
    ],
    "publicRead": true,
    "publicCreate": false
  },
  {
    "name": "CommentReaction",
    "type": "object",
    "properties": {
      "commentId": {
        "type": "relation",
        "ref": "Comment",
        "parent": true,
        "description": "The comment being reacted to"
      },
      "emoji": {
        "type": "enum",
        "values": [
          "like",
          "love",
          "laugh",
          "wow",
          "sad",
          "fire"
        ],
        "labels": {
          "like": "👍",
          "love": "❤️",
          "laugh": "😂",
          "wow": "😮",
          "sad": "😢",
          "fire": "🔥"
        },
        "description": "The emoji reaction chosen"
      }
    },
    "required": [
      "commentId",
      "emoji"
    ],
    "publicRead": true,
    "publicCreate": false
  },
  {
    "name": "AdBanner",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 100,
        "description": "Internal name of the ad"
      },
      "placement": {
        "type": "enum",
        "values": [
          "home_top",
          "home_middle",
          "watch_below_player",
          "watch_sidebar"
        ],
        "labels": {
          "home_top": "Beranda – Atas",
          "home_middle": "Beranda – Tengah",
          "watch_below_player": "Streaming – Bawah Player",
          "watch_sidebar": "Streaming – Sidebar"
        },
        "description": "Where the banner is displayed"
      },
      "imageDesktopUrl": {
        "type": "string",
        "maxLength": 500,
        "description": "Banner image for desktop"
      },
      "imageMobileUrl": {
        "type": "string",
        "maxLength": 500,
        "description": "Banner image for mobile"
      },
      "linkUrl": {
        "type": "string",
        "maxLength": 500,
        "description": "Destination URL when clicked"
      },
      "isActive": {
        "type": "boolean",
        "description": "Whether the banner is shown",
        "default": true
      }
    },
    "required": [
      "placement",
      "imageDesktopUrl"
    ],
    "publicRead": true,
    "publicCreate": false
  }
]
